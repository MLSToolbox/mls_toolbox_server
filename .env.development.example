# Configuración para ambiente DEVELOPMENT (desarrollo en servidor gessi.cs.upc.edu)
# Copiar este archivo a .env.development y ajustar según necesidades

ENVIRONMENT=development

# Backend Gateway Configuration
PORT=5000
EXTERNAL_PORT=5001
HOST=0.0.0.0
DEBUG=True

# Docker Configuration
IMAGE_TAG=mls_toolbox_server:development
CONTAINER_NAME=mls_toolbox_server

# Service URLs (URLs internas de Docker para conectar con otros servicios)
CODE_GENERATOR_URL=http://mls_code_generator:5050
CODE_ASSESSMENT_URL=http://mls_toolbox_code_assessment:5060

# Docker Network
DOCKER_NETWORK=mls-network
