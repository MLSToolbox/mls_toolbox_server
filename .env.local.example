# Configuración para ambiente LOCAL (desarrollo local)
# Copiar este archivo a .env.local y ajustar según necesidades

ENVIRONMENT=local

# Backend Gateway Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=True

# Docker Configuration
IMAGE_TAG=mls_toolbox_server:local
CONTAINER_NAME=mls_toolbox_server

# Service URLs (URLs internas de Docker para conectar con otros servicios)
CODE_GENERATOR_URL=http://mls_code_generator:5050
CODE_ASSESSMENT_URL=http://mls_toolbox_code_assessment:5060

# Docker Network
DOCKER_NETWORK=mls-network
